# Environment Configuration Template
# Copy to .env and replace with production values before running in production.

PORT=3000
NODE_ENV=production
DB_PATH=./database.sqlite

# Security Credentials (Required in production)
DEFAULT_ADMIN_PASSWORD=change_this_admin_password_in_prod
DEFAULT_STAFF_PASSWORD=change_this_staff_password_in_prod
SESSION_SECRET=change_this_random_session_secret_32chars
